# Copy to .env. No API key or bridge token is needed: log in with ChatGPT separately.
GENERATION_PORT=17374
CODEX_CLI_VERSION=0.163.0
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_MS=180000
# Limit for ordinary jobs (letters and helpers). Analysis jobs are not capped here.
GENERATION_MAX_PENDING=20
# Shared ceiling for relevance and market analysis, additionally constrained by memory.
# Legacy GENERATION_MAX_CONCURRENT_RELEVANCE is used only if the new setting is absent.
GENERATION_MAX_CONCURRENT_ANALYSIS=4
# Scheduler budget: percent of OS/container memory, not a fixed RAM allocation.
GENERATION_MEMORY_PERCENT=25
# Initial per-CLI estimate until measured successful executions are available.
GENERATION_JOB_MEMORY_MIB=128
GENERATION_RETENTION_DAYS=7
# GET /metrics is read-only; optional runId filters backend relevance/market runs.
# Detailed timings are enabled without raw stdout/stderr or prompt logging.
